APP_NAME=Custom-Framework
APP_DEBUG=false
STRICT_TYPE=true
CSP=false

TIMEZONE=Asia/Jakarta

DB_TYPE=mysql
DB_HOST=127.0.0.1
DB_NAME=Native-crud
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4
DB_COLLATION=

# Request rate setting
WEB_REQUEST_RATE_LIMIT=15
WEB_REQUEST_TIMEFRAME=60
WEB_REQUEST_BAN_TIME=10

# Request rate setting
API_REQUEST_RATE_LIMIT=30
API_REQUEST_TIMEFRAME=120
API_REQUEST_BAN_TIME=5

# GET requests
GET_STRICT=false
GET_ALLOWED=css,js,map,mp4,mp3,gif,ico
GET_DENIED=log,php

#-----------#
ALLOW_CORS_FROM_ANYWHERE=false
ALLOW_CREDENTIALS=false
ALLOWED_ORIGINS=http://localhost:5173
ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
ALLOWED_HEADERS=Content-Type,Authorization,X-Requested-With,X-CSRF-TOKEN
EXPOSED_HEADERS=Content-Length,X-Total-Count
CORS_MAX_AGE=86400

# Auto loader
AUTO_LOAD_AUTO_RESOLVE=true
AUTO_LOAD_CLASS_DEPENDENCIES=true
AUTO_LOAD_RECURSIVE_CLASS_SCANNING=true
AUTO_LOAD_RECURSIVE_IGNORED_DIRS=database,
AUTO_LOAD_RECURSIVE_EXCEPTION_FILES=
AUTO_LOAD_RECURSIVE_IGNORED_FILES=
AUTO_LOAD_USER_PATH_DEFINED_CLASS=false
AUTO_LOAD_CLASS_ALWAYS_EXISTS=false
