DB_TYPE=mysql
DB_HOST=127.0.0.1
DB_NAME=Native-crud
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4
DB_COLLATION=

# Request rate setting
WEB_REQUEST_RATE_LIMIT=15
WEB_REQUEST_TIMEFRAME=60
WEB_REQUEST_BAN_TIME=10

# Request rate setting
API_REQUEST_RATE_LIMIT=30
API_REQUEST_TIMEFRAME=60
API_REQUEST_BAN_TIME=5


# GET requests
GET_STRICT=false
GET_ALLOWED=css,js,map,mp4,mp3,gif,ico
GET_DENIED=log,php

#-----------#
ALLOW_CORS_FROM_ANYWHERE=true
ALLOW_CREDENTIALS=true
ALLOWED_ORIGINS=

PREFER_PRETTY_PRINT=true

WELCOME_MESSAGE=true
CLASS_REGISTER=true

